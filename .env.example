# Application
APP_NAME=Bytes Signature Service
# development | staging | production | test
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
API_V1_PREFIX=/api/v1
# Serve the OpenAPI documentation (/docs, /openapi.json). Disable in production.
API_DOCS_ENABLED=true

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://signature:signature@localhost:5432/signature

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (defaults derive from REDIS_URL if unset)
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# Platform operator API key (tenant management) - change for real deployments.
# Generate with: make secrets
OPERATOR_API_KEY=dev-operator-key

# Master key for encrypting tenant secrets at rest (base64, 32 bytes).
# Generate with: make secrets. Losing this key makes the stored secrets
# unreadable.
SECRET_ENCRYPTION_KEY=

# Token required to read /metrics (X-Metrics-Token header or Bearer token).
METRICS_TOKEN=

# Comma-separated list of allowed Host headers (empty = allow all).
TRUSTED_HOSTS=

# Redirect plain HTTP to HTTPS (enable when a TLS terminator runs).
HTTPS_REDIRECT=false

# Maximum accepted HTTP request body size in bytes (10 MiB).
MAX_REQUEST_BODY_BYTES=10485760

# Requests per minute and client (0 = disabled).
API_RATE_LIMIT_PER_MINUTE=120

# Used by docker-compose for the postgres container
POSTGRES_USER=signature
POSTGRES_PASSWORD=signature
POSTGRES_DB=signature

# Password for the Redis container (used by docker-compose).
REDIS_PASSWORD=redis-dev-password

# Mail flow via Exchange connectors (SMTP)
# Public port on the VPS that the M365 outbound connector connects to.
# The container itself listens on 2525 (mapped by docker-compose).
SMTP_PUBLIC_PORT=25
# Comma-separated source IPs/CIDRs allowed to send to our inbound SMTP
# server (Exchange Online egress ranges of the tenant). Empty = allow all
# (only for local testing, never in production).
SMTP_ALLOWED_HOSTS=
# TLS certificate for the inbound SMTP server (Let's Encrypt on the VPS).
SMTP_CERT_DIR=./certs
SMTP_INBOUND_TLS_CERTFILE=/certs/fullchain.pem
SMTP_INBOUND_TLS_KEYFILE=/certs/privkey.pem
SMTP_INBOUND_REQUIRE_TLS=true
# Public hostname of this relay. Mail to any mailbox at this hostname is
# accepted and discarded (needed for the Microsoft connector validation).
SMTP_RELAY_HOSTNAME=relay.example.com
# Where processed mail is sent back to (M365 inbound connector host,
# typically "<your-domain>.mail.protection.outlook.com").
SMTP_OUTBOUND_DEFAULT_HOST=
SMTP_OUTBOUND_PORT=25
SMTP_OUTBOUND_STARTTLS=true
